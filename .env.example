# Application URLs
AA_BASE_URL=/aapackages
AA_API_BASE_URL=/aapackages

# MySQL
AA_DB_HOST=127.0.0.1
AA_DB_PORT=3306
AA_DB_NAME=aapackages
AA_DB_USER=root
AA_DB_PASS=
# For Aiven/managed MySQL on Linux:
# AA_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Sessions and browser access
AA_SESSION_TIMEOUT=28800
AA_SESSION_SECURE=false
# Comma-separated full origins. Leave blank for same-origin only.
AA_ALLOWED_ORIGINS=

# Store digits only, including Pakistan country code.
AA_WHATSAPP_NUMBER=923108504003

# Optional persistent upload location/CDN prefix.
AA_UPLOAD_PATH=
AA_UPLOAD_URL=uploads

# Payment mode and provider secrets
AA_PAYMENT_MODE=sandbox
AA_VISA_PUBLIC_KEY=
AA_VISA_SECRET_KEY=
AA_MASTERCARD_PUBLIC_KEY=
AA_MASTERCARD_SECRET_KEY=
AA_CARD_PUBLIC_KEY=
AA_CARD_SECRET_KEY=
AA_JAZZCASH_MERCHANT_ID=
AA_JAZZCASH_PASSWORD=
AA_JAZZCASH_SALT=
AA_EASYPAISA_STORE_ID=
AA_EASYPAISA_HASH_KEY=
