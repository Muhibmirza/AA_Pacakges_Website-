# Application URLs (blank when installed at the domain root)
AA_BASE_URL=
AA_API_BASE_URL=
# Set this to the final HTTPS domain for canonical SEO URLs.
AA_SITE_URL=https://example.com

# MySQL
AA_DB_HOST=localhost
AA_DB_PORT=3306
AA_DB_NAME=aapackages
AA_DB_USER=root
AA_DB_PASS=
# Optional SSL certificate path when required by your database provider:
# AA_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Sessions and browser access
AA_SESSION_TIMEOUT=28800
AA_SESSION_SECURE=true
# Comma-separated full origins. Leave blank for same-origin only.
AA_ALLOWED_ORIGINS=

# Store digits only, including Pakistan country code.
AA_WHATSAPP_NUMBER=923108504003

# Optional persistent upload location/CDN prefix.
AA_UPLOAD_PATH=
AA_UPLOAD_URL=uploads

# Checkout is Cash on Delivery only. No payment gateway secrets are required.
